code = r'''
import os
import sqlite3
import datetime
from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.clock import Clock
from kivy.uix.popup import Popup

def get_db_path():
    return os.path.join(App.get_running_app().user_data_dir, "finance.db")

def init_db():
    conn = sqlite3.connect(get_db_path())
    cur = conn.cursor()
    cur.execute("""
    CREATE TABLE IF NOT EXISTS customers (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        mobile TEXT,
        alt_mobile TEXT,
        address TEXT,
        product TEXT,
        purchase_date TEXT,
        due_date TEXT
    )""")
    conn.commit()
    conn.close()

class FinanceApp(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(orientation='vertical', **kwargs)

        self.add_widget(Label(text="Customer Name"))
        self.name = TextInput()
        self.add_widget(self.name)

        self.add_widget(Label(text="Mobile"))
        self.mobile = TextInput()
        self.add_widget(self.mobile)

        self.add_widget(Label(text="Alt. Mobile"))
        self.alt_mobile = TextInput()
        self.add_widget(self.alt_mobile)

        self.add_widget(Label(text="Address"))
        self.address = TextInput()
        self.add_widget(self.address)

        self.add_widget(Label(text="Product"))
        self.product = TextInput()
        self.add_widget(self.product)

        self.add_widget(Label(text="Purchase Date (YYYY-MM-DD)"))
        self.purchase_date = TextInput()
        self.add_widget(self.purchase_date)

        self.add_widget(Label(text="Due Date (YYYY-MM-DD)"))
        self.due_date = TextInput()
        self.add_widget(self.due_date)

        self.save_btn = Button(text="Save Customer")
        self.save_btn.bind(on_press=self.save_customer)
        self.add_widget(self.save_btn)

        self.show_btn = Button(text="Show Customers")
        self.show_btn.bind(on_press=self.show_customers)
        self.add_widget(self.show_btn)

        self.result = Label(text="")
        self.add_widget(self.result)

        # Auto reminder check every 30 sec
        Clock.schedule_interval(self.check_reminders, 30)

    def save_customer(self, instance):
        conn = sqlite3.connect(get_db_path())
        cur = conn.cursor()
        cur.execute("INSERT INTO customers (name,mobile,alt_mobile,address,product,purchase_date,due_date) VALUES (?,?,?,?,?,?,?)",
            (self.name.text, self.mobile.text, self.alt_mobile.text, self.address.text,
             self.product.text, self.purchase_date.text, self.due_date.text))
        conn.commit()
        conn.close()
        self.result.text = f"✅ Saved {self.name.text}"
        self.clear_inputs()

    def clear_inputs(self):
        self.name.text = ""
        self.mobile.text = ""
        self.alt_mobile.text = ""
        self.address.text = ""
        self.product.text = ""
        self.purchase_date.text = ""
        self.due_date.text = ""

    def show_customers(self, instance):
        conn = sqlite3.connect(get_db_path())
        cur = conn.cursor()
        cur.execute("SELECT name, mobile, product, due_date FROM customers")
        rows = cur.fetchall()
        conn.close()
        text = "\n".join([f"{r[0]} | {r[1]} | {r[2]} | Due: {r[3]}" for r in rows])
        self.result.text = text if text else "No Customers Found"

    def check_reminders(self, dt):
        today = datetime.date.today()
        conn = sqlite3.connect(get_db_path())
        cur = conn.cursor()
        cur.execute("SELECT name, due_date FROM customers")
        rows = cur.fetchall()
        conn.close()

        for name, due_date in rows:
            try:
                due = datetime.datetime.strptime(due_date, "%Y-%m-%d").date()
                days_left = (due - today).days
                if days_left == 2:  # Reminder 2 days before
                    self.show_popup(f"Reminder: {name}'s payment due on {due}")
            except:
                pass

    def show_popup(self, message):
        popup = Popup(title="🔔 Payment Reminder",
                      content=Label(text=message),
                      size_hint=(0.8, 0.3))
        popup.open()

class FinanceAppMain(App):
    def build(self):
        init_db()
        return FinanceApp()

if __name__ == "__main__":
    FinanceAppMain().run()
'''
with open("main.py", "w") as f:
    f.write(code)

